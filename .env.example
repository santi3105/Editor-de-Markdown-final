# Copia este archivo como ".env" y ajusta los valores. El archivo ".env" NO se sube a GitHub.

# Puerto del servidor (Render lo asigna solo; en local se usa 3000)
PORT=3000

# "production" en Render. En local déjalo vacío o en "development".
NODE_ENV=development

# Orígenes (separados por coma) que pueden llamar a la API desde otro dominio (CORS).
# El mismo origen siempre está permitido. En producción déjalo vacío si el frontend
# lo sirve este mismo servidor, o pon aquí la URL del frontend si se publica aparte.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# API externa de citas que consulta el servidor
QUOTES_API_URL=https://dummyjson.com/quotes/random

# (Opcional) Ruta del archivo donde se guardan los documentos
# DATA_FILE=./data/documents.json

# Si algún día se usa una API con clave, va AQUÍ y se lee con process.env.NOMBRE
# (nunca en el frontend ni escrita en el código):
# CLAVE_API_EJEMPLO=
